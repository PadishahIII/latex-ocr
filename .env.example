# latex-ocr environment configuration
# Copy to `.env` (or export in your shell) and fill in real values.
# NEVER commit real credentials.

# ---------------------------------------------------------------------------
# MLflow / MinIO (optional: only needed for training-time tracking & artifact
# storage, or for loading models from MLflow runs via `trainers/eval.py`).
# `recipe.utils.mlflow_util.setup_mlflow` reads these; it raises a clear error
# when required ones are missing. Set MLFLOW_ENABLE=false (or disable MLflow in
# the recipe config) to train without any MLflow connectivity.
# ---------------------------------------------------------------------------
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=15123
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# Artifact upload/download timeout in seconds
MLFLOW_ARTIFACT_TIMEOUT=300

MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=mlflow-artifacts

# Master switch for MLflow operations inside the recipe framework
MLFLOW_ENABLE=true

# ---------------------------------------------------------------------------
# Inference API server (latex_ocr.serve)
# ---------------------------------------------------------------------------
LATEX_OCR_MODEL_PATH=models/checkpoints/latex-ocr-coca-finetune.pth
LATEX_OCR_DEVICE=cuda
LATEX_OCR_MAX_LENGTH=354
LATEX_OCR_BEAM_SIZE=4
LATEX_OCR_MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Runtime conveniences
# ---------------------------------------------------------------------------
# Restrict visible CUDA devices (also read by trainers/train.py)
# LATEX_OCR_VISIBLE_CUDA_DEVICES=0
# Escape hatch for boxes with unstable NVLink / GPU P2P
# LATEX_OCR_DISABLE_NCCL_P2P=1
# Reduce HF Hub chatter / force offline once the dataset is cached
# HF_HUB_OFFLINE=1
